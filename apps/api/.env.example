# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database (single-node replica set; see docker-compose.yml) ────────────────
MONGODB_URI=mongodb://localhost:27017/sm_auto?replicaSet=rs0&directConnection=true

# ── CORS (comma-separated; admin + storefront origins) ────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production example:
# CORS_ORIGINS=https://admin.sparemec.ae,https://sparemec.ae

# ── Auth ─────────────────────────────────────────────────────────────────────
# PRODUCTION: generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 chars; use different values for access and refresh.
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
ADMIN_REFRESH_COOKIE=sm_adm_rt
CUSTOMER_REFRESH_COOKIE=sm_cust_rt
# PRODUCTION: set COOKIE_DOMAIN to your apex domain and COOKIE_SAMESITE=lax (same domain) or none (cross-domain + HTTPS)
# COOKIE_DOMAIN=sparemec.ae
# COOKIE_SAMESITE=lax

# ── Cloudinary (optional in dev; required for image uploads in production) ────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sparemec

# ── Google OAuth (optional; enables Google sign-in on storefront) ─────────────
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorised JS origins: https://sparemec.ae  |  Authorised redirect URIs: not required (token flow)
GOOGLE_CLIENT_ID=

# ── Email / Notifications ─────────────────────────────────────────────────────
# If SMTP_HOST is blank, all emails are logged to console (dev-friendly).
# Production: any SMTP provider (Mailgun, SendGrid, SES, etc.) works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@sparemec.ae
# Admin notification email (receives a copy of every new order/inquiry/lead/quote)
ADMIN_NOTIFY_EMAIL=

# ── Storefront (used in customer-facing password reset links) ─────────────────
STOREFRONT_URL=http://localhost:3000
# Production example:
# STOREFRONT_URL=https://sparemec.ae

# ── Seed (npm run seed:admin / seed:catalog) ──────────────────────────────────
# PRODUCTION: change password immediately after first login.
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@sparemec.local
SEED_ADMIN_PASSWORD=ChangeMe123!
