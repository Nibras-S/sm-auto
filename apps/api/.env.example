# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database (single-node replica set; see docker-compose.yml) ────────────────
MONGODB_URI=mongodb://localhost:27017/sm_auto?replicaSet=rs0&directConnection=true

# ── CORS (comma-separated; admin + storefront origins) ────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Auth (use long random strings in production) ──────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-16
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-16
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
ADMIN_REFRESH_COOKIE=sm_adm_rt
CUSTOMER_REFRESH_COOKIE=sm_cust_rt
# COOKIE_DOMAIN=
# COOKIE_SAMESITE=lax

# ── Seed (npm run seed:admin) ─────────────────────────────────────────────────
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@sparemec.local
SEED_ADMIN_PASSWORD=ChangeMe123!
