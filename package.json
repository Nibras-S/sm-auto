{
  "name": "sm-auto",
  "version": "0.1.0",
  "private": true,
  "description": "Spare Mec — Automotive Spare Parts E-Commerce + CRM/Admin (monorepo)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,admin,store -c green,magenta,cyan \"npm:dev:api\" \"npm:dev:admin\" \"npm:dev:storefront\"",
    "dev:api": "npm --workspace @sm/api run dev",
    "dev:admin": "npm --workspace @sm/admin run dev",
    "dev:storefront": "npm --workspace smauto run start",
    "build": "npm --workspace @sm/shared run build && npm --workspace @sm/api run build && npm --workspace @sm/admin run build",
    "build:shared": "npm --workspace @sm/shared run build",
    "typecheck": "npm --workspace @sm/shared run typecheck && npm --workspace @sm/api run typecheck && npm --workspace @sm/admin run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "seed:admin": "npm --workspace @sm/api run seed:admin"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
